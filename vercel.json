{
  "outputDirectory": "dist/client",
  "trailingSlash": false,
  "framework": null,
  "rewrites": [
    { "source": "/api/music", "destination": "https://itunes.apple.com/search" },
    { "source": "/api/steam", "destination": "https://store.steampowered.com/api/appdetails" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.jsdos",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
